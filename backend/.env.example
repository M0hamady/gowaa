# Preview only. Never use production credentials or production databases here.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-render-service.onrender.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DB_SSLMODE=require
REDIS_URL=rediss://default:PASSWORD@HOST:PORT
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/jowwa_preview?retryWrites=true&w=majority
MONGODB_DATABASE=jowwa_preview
SUPABASE_URL=https://YOUR-PREVIEW-PROJECT.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
CORS_ALLOWED_ORIGINS=https://YOUR-VERCEL-PREVIEW.vercel.app
CSRF_TRUSTED_ORIGINS=https://YOUR-VERCEL-PREVIEW.vercel.app
